/*
Till now.. this feelss like somee unpolished UI.. I wana make it in some theme.. like maybe old radio player. Lets see what I will come up with
till then BYEE!
*/
$main: #E9B872;
$bg: #151515;
$bg-light: #1F1F1F;
$alert: #A63D40;
$soft: #90A959;
$calm: #6494AA;
$gold: #FFD700;

/*
====================================================================================================================================================
                        GLOBAL STYLES & THEMING
====================================================================================================================================================
*/

Screen {
    layers: transition;
    align: center middle;
    background: $bg;
}

Button:hover {
    text-style: italic;
}

.section-label {
    color: $soft;
    margin: 1 0;
    text-style: bold;
}

/*
====================================================================================================================================================
                        WELCOME & SETUP
====================================================================================================================================================
*/

#welcome-text {
    width: auto;
    height: auto;
    color: $alert; 
    text-style: bold;
    content-align: center middle;
}

#skip-hint {
    dock: bottom;
    align: right bottom;
    color: $text-muted;
    opacity: 0.4;
    padding: 0 1;
}

/* Setup Workspace Layout */


/*
====================================================================================================================================================
                        HOME & MAIN TABS
====================================================================================================================================================
*/
HomeScreen {
    background: $bg;
    color: $gold;
}

#main-app-shell {
    padding: 1 2;
    height: 1fr;
}

#home-tabs {
    height: 1fr;
    margin-bottom: 1;
}

#home-tabs > Tabs {
    background: transparent;
    border: none;
    width: 100%;
    align: center middle;
}

#home-tabs > Tabs > Horizontal {
    width: auto;
}

Tab {
    color: $main;
    background: transparent;
    text-style: bold;
}

Tabs > .textual-tabs--active {
    color: $gold;
    text-style: underline bold;
}

#home-tabs Underline > .underline--bar {
    color: $gold;
    background: $main;
}

/* --- CONTENT PANES --- */
TabPane {
    background: $bg-light;
}

/* --- DATA TABLE (The Song List) --- */
DataTable {
    background: $bg;
    color: $main;
    border: tall $bg-light;
    height: 1fr;
    scrollbar-color: $calm;
    scrollbar-background: $bg-light;
    scrollbar-color-hover: $soft;
    scrollbar-color-active: $soft;
    scrollbar-background-hover: $bg-light;
    scrollbar-background-active: $bg-light;
}

DataTable:focus {
    border: tall $gold;
}

DataTable > .datatable--cursor {
    background: $main;
    color: $bg;
}

/* --- PLAYLIST BUTTONS (The Creative Part) --- */
.playlist-btn {
    width: 1fr;
    margin: 0 1;
    background: transparent;
    border: tall $main 30%;
    color: $main;
    content-align: left middle;
}

.playlist-btn:hover {
    background: $main 10%;
    border: tall $gold;
    color: $gold;
}

/* --- SETTINGS & BUTTONS --- */
.section-label {
    text-style: bold;
    color: $gold;
    margin: 1 0;
    padding-left: 1;
}

#btn-regenerate, #btn-add-dir {
    background: $soft;
    color: $bg;
}

#btn-remove-dir {
    background: $alert;
    color: white;
}

#btn-resync {
    background: $calm;
    color: white;
}

/*
====================================================================================================================================================
                        PLAYER SCREEN (FULL FOCUS VIEW)
====================================================================================================================================================
*/

#player-container {
    align: center middle;
    width: 100%;
    height: 100%;
    padding: 1 2;
    background: $bg;
}

/* TOP NAVIGATION */
#top-nav {
    height: 3;
    align: center middle;
    margin-bottom: 1;
}

#playlist-name-title {
    width: 1fr;
    text-align: center;
    text-style: bold;
    color: $calm;
}

#top-nav Button {
    min-width: 4;
    background: transparent;
    border: none;
    color: $calm;
}

/* MIDDLE CONTENT SPLIT */
#middle-content {
    height: 1fr; /* Takes up all space between header and footer */
}

#left-pane {
    width: 50%;
    height: 100%;
    align: left middle;
    padding-left: 10;
}

#right-pane {
    width: 50%;
    height: 100%;
}

/* VISUALISER (ALPHA VERSION) */
#visualiser-container {
    width: 45;
    height: 18;
    border: round $soft;
    background: $bg-light;
    content-align: center middle;
}

#visualiser {
    color: $alert;
    text-style: bold;
}

/* ART & INFO (LEFT PANE) */
#art-container {
    width: 40;
    height: 15;
    border: round $gold;
    background: $bg;
    content-align: center middle;
}

#big-art {
    content-align: center middle;
    color: $main;
    text-style: bold;
}

#info-container {
    height: auto;
    width: 40;
    align: left top;
    margin-top: 1;
    padding-left: 1;
}

#song-title {
    text-align: left;
    width: 100%;
    height: 1;
    color: #ffffff;
    text-style: bold;
}

#song-artist {
    color: #888888;
    width: 100%;
    height: 1;
    text-align: left;
    text-style: bold;
    margin-top: 0;
}

/* TIMELINE WRAPPER */
#timeline-wrapper {
    height: auto;
    margin: 1 0;
    align: center middle;
}

#timeline-info {
    height: 3;
    align: center middle;
}

#timeline-slider {
    width: 80%;
    margin: 0 2;
    border: round $gold;
}

#start-time, #end-time {
    width: 7;
    height: 1;
    text-style: bold;
    color: gold;
    margin: 1;
}

#next-section {
    width: 25%;
    height: 3;
    align: right top;
    padding-top: 1;
}

#auto-play {
    margin-right: 1;
    margin-top: 1;
}

#auto-play-switch {
    margin-top: 0;
}

#button-row {
    height: 5;
    align: center middle;
    margin-top: 1;
}

#auto-play-switch {
    border: none;
    background: transparent;
}

#pause, #resume {
    border: round $gold;
    text-style: bold;
    background: transparent;
}

#next, #prev{
    border: round $calm;
    text-style: bold;
    background: transparent;
}

#vol-section {
    width: 25%;
    align: left middle;
}

#vol-slider {
    width: 25;
    border: round $calm;
}

#controls-section {
    width: 50%;
    align: center middle;
}

#controls-section Button {
    margin: 0 1;
    min-width: 4;
}

#next-section {
    width: 25%;
    align: right middle;
}

#next-section Label {
    margin-right: 1;
    color: gray;
}

#go-back {
    width: auto;     
    min-width: 4;
    border: none;
    background: transparent;
    margin-top: 0;
}

/*
====================================================================================================================================================
                        MINI PLAYER (PERSISTENT BAR)
====================================================================================================================================================
*/

MiniPlayer {
    dock: bottom;
    height: 7;
    width: 100%;
    background: $bg-light;
    border-top: solid $main;
}

#mini-info {
    width: 25%;
    height: 100%;
    align: left middle;
}

#mini-title {
    text-style: bold;
    color: #ffffff;
}

#mini-artist {
    color: #888888;
}

#mini-controls {
    width: auto;
    align: center middle;
    height: 5;
    margin: 0 2;
    background: $bg;
    border: round $calm;
}

#mini-controls Button {
    min-width: 4;
    height: 3;
    border: none;
    background: transparent;
    color: $calm;
}

/* MINI TIMELINE WRAPPER */
#mini-timeline-wrapper {
    width: 1fr;
    height: 100%;
    align: center middle;

}

#mini-timeline-info {
    height: 3;
    align: center middle;
}

#mini-timeline-slider {
    width: 1fr;
    height: 1;
    margin: 0 1; 
    border: round $gold;
    padding: 0;
}

#mini-start-time, #mini-end-time {
    width: 7;
    height: 1;
    text-style: bold;
    color: $gold;
    margin: 1;
}

